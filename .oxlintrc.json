{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  // The gate denies warnings (see `npm run lint`), so everything enabled here
  // has to be something worth stopping for. `pedantic` was measured and left
  // out: it wants a `u` flag on every regex in the Guard's tests and finds
  // nothing this repository cares about.
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },

  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "node"],

  "env": { "builtin": true, "node": true },

  "rules": {
    // The Overlay publishes `__pointout` to the consumer's page. The
    // name is the contract a seam-2 test reads, not a style choice. `_debugOwner`
    // and `_debugStack` are React's own fiber field names, which this repo reads
    // and does not get to choose; reading them is the whole owner-chain mechanism
    // (spec §4, §6).
    "no-underscore-dangle": [
      "error",
      { "allow": ["__pointout", "_debugOwner", "_debugStack"] }
    ],

    // A side-effect import is how Vite loads CSS, and `packaging.test` requires
    // the package on purpose, to prove that requiring it throws.
    "import/no-unassigned-import": "off",

    // A helper defined inside the `describe` that uses it is how these tests
    // are written, and moving them out would separate each from its subject.
    "unicorn/consistent-function-scoping": "off"
  },

  "ignorePatterns": [
    "dist/**",
    "**/dist/**",
    "coverage/**",
    "test-results/**",
    // Committed dead ends, never edited (spec §1).
    "spike-*/**",
    // What `next dev` writes into examples/next-app, and the harness's
    // per-server tsconfigs beside it.
    "**/.next/**",
    "**/.harness/**"
  ],

  "overrides": [
    {
      "files": ["test/**/*.ts"],
      "plugins": ["vitest"]
    },
    {
      // Two `it.skip`s hold the place tickets 20 and 21 fill. They are the
      // suite's current answer to "what does this command do today", not
      // forgotten tests.
      "files": ["test/seam3/**/*.ts"],
      "plugins": ["vitest"],
      "rules": { "vitest/no-disabled-tests": "off" }
    },
    {
      // The test bed and the Overlay's own surfaces (ADR-0004).
      "files": ["**/*.tsx"],
      "plugins": ["react"],
      // React 19's automatic JSX runtime: nothing needs `React` in scope.
      "rules": { "react/react-in-jsx-scope": "off" }
    },
    {
      // The Next test bed's framed route is this app's own page on its own
      // origin, and it must run its scripts there to hydrate: scripts and the
      // same origin together are the case the fixture exists to hold.
      "files": ["examples/next-app/fixtures/FramedRoute.tsx"],
      "plugins": ["react"],
      "rules": { "react/iframe-missing-sandbox": "off" }
    }
  ]
}
