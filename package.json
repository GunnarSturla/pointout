{
  "name": "vite-agent-inspect",
  "version": "0.0.0",
  "private": true,
  "description": "Pick an element in the running app, type a request about it, and have it reach the Claude Code session you are already working in.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs-entry.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "vite-agent-inspect": "./dist/cli/main.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "examples/react-app"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "pretypecheck": "npm run build",
    "typecheck": "tsc -p tsconfig.json && tsc -p examples/react-app/tsconfig.json",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "npm run format && oxlint --deny-warnings --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "predev": "npm run build",
    "dev": "npm run dev --workspace vite-agent-inspect-example",
    "build:example": "npm run build --workspace vite-agent-inspect-example",
    "test": "npm run test:seam1 && npm run test:seam2",
    "pretest:seam1": "npm run build",
    "test:seam1": "vitest run",
    "pretest:seam2": "npm run build",
    "test:seam2": "playwright test",
    "pretest:seam2:fast": "npm run build",
    "test:seam2:fast": "playwright test --project=chromium",
    "pretest:seam3": "npm run build",
    "test:seam3": "vitest run --config vitest.seam3.config.ts",
    "pretest:seam3:model": "npm run build",
    "test:seam3:model": "vitest run --config vitest.seam3.config.ts --mode model"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ]
}
